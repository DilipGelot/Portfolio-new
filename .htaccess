ErrorDocument 404 /404.html

RewriteEngine On

# Alias /faq to /knowledge
RewriteRule ^faq$ knowledge [NC,L]

# Redirect external requests for .html to extension-less URLs
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]+)\.html\ HTTP/
RewriteRule ^(.*)\.html$ /$1 [R=301,L]

# Resolve extension-less URLs internally to .html files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# Enable Gzip/Deflate compression
<IfModule mod_deflate.c>
    # Compress HTML, CSS, JavaScript, Text, XML and fonts
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/xml application/xhtml+xml application/json font/ttf font/otf image/svg+xml
</IfModule>

# Enable Caching / Expires Headers
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images (Cache for 1 Year)
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # CSS, JavaScript (Cache for 1 Month)
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
    
    # Web Fonts (Cache for 1 Year)
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    
    # Default cache-control headers
    ExpiresDefault "access plus 2 days"
</IfModule>

# Set Cache-Control Headers for specific file extension matches if expires is not supported
<IfModule mod_headers.c>
    # Cache static files for 1 year
    <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|webp|svg|swf|woff|woff2|otf|ttf)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
    # Cache CSS and JS for 1 month
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
</IfModule>
